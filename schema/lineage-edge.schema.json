{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tmzncty/computer-network-archaeology/schema/lineage-edge.schema.json",
  "title": "Computer Network Archaeology Lineage Edge",
  "description": "Evidence-bearing relationship between two historical networking artifacts, standards, concepts, roles, or practices. Lineage must not be inferred from similarity alone.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "from", "to", "relation", "scope", "property", "certainty", "directness", "sources"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional relative or absolute schema locator for editor integration."
    },
    "id": {"type": "string", "pattern": "^LIN-[0-9]{4,}$"},
    "from": {"$ref": "#/$defs/endpoint"},
    "to": {"$ref": "#/$defs/endpoint"},
    "relation": {
      "type": "string",
      "enum": [
        "revision-of",
        "successor-of",
        "replaced-by",
        "standardizes",
        "derived-from",
        "splits-into",
        "merges-into",
        "survives-as",
        "role-descends-into",
        "interface-convention-inherited-by",
        "operational-practice-inherited-by",
        "influenced",
        "possibly-influenced",
        "coexisted-with",
        "carried-over",
        "encapsulated-over",
        "gatewayed-to",
        "interworked-with"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "physical",
          "electrical",
          "connector",
          "interface",
          "link",
          "framing",
          "addressing",
          "network",
          "routing",
          "transport",
          "application",
          "software-api",
          "operations",
          "management",
          "economics",
          "institutional",
          "terminology",
          "architecture",
          "other"
        ]
      },
      "uniqueItems": true
    },
    "property": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Specific mechanism, convention, role, or property inherited/revised/rejected. Avoid vague values such as 'networking ideas'."
    },
    "date_or_range": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "value": {"type": "string"},
        "precision": {"type": "string", "enum": ["day", "month", "year", "decade", "range", "circa", "unknown"]},
        "notes": {"type": ["string", "null"]}
      },
      "required": ["value", "precision"]
    },
    "certainty": {"type": "string", "enum": ["confirmed", "probable", "disputed", "unknown", "mixed"]},
    "directness": {
      "type": "string",
      "enum": ["formal", "documented-design", "documented-operational", "participant-testimony", "scholarly-reconstruction", "hypothesis"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "locator", "supports"],
        "properties": {
          "source_ref": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "locator": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "supports": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "negative_claims": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": [],
      "description": "Explicitly record what the edge does NOT establish; important for avoiding causal overreach."
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "notes": {"type": ["string", "null"]},
    "last_reviewed": {"type": ["string", "null"], "format": "date"}
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "artifact_id": {"type": ["string", "null"], "pattern": "^ART-[0-9]{4,}$"},
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "historical_term": {"type": ["string", "null"]}
      }
    }
  }
}
